# ==============================================================================
# CyberShield AI — Comprehensive Git Ignore Rules
# Guarantees zero leakage of credentials, environments, node_modules, and binaries
# ==============================================================================

# --- Environment & Secret Credentials ---
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local
*.key
*.pem
*.p12
*.keystore
private_keys/
secrets/

# Keep configuration templates tracked
!.env.example

# --- Database Files & Local Storage ---
*.sqlite
*.sqlite3
*.db
cybershield.db
*.db-journal
*.db-wal
*.db-shm

# --- Python & Virtual Environments ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.hypothesis/

# Virtual Environments
.venv/
venv/
ENV/
env/
backend/.venv/
backend/venv/

# --- Node.js & Frontend Artifacts ---
node_modules/
frontend/node_modules/
blockchain/node_modules/
frontend/dist/
frontend/build/
dist/
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Hardhat & Solidity Build Caches ---
blockchain/artifacts/
blockchain/cache/
artifacts/
cache/

# --- IDEs, Editors & OS Files ---
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
